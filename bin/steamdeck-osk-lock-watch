#!/usr/bin/env bash
# Show the on-screen keyboard while the session is locked; hide after unlock.
set -euo pipefail

OSK="$HOME/.local/bin/steamdeck-osk"
LOCKCHECK=/usr/share/omarchy/bin/omarchy-hyprland-session-locked
PIDFILE="${XDG_RUNTIME_DIR:-/tmp}/steamdeck-osk-lock-watch.pid"

if [[ -f "$PIDFILE" ]]; then
  old="$(cat "$PIDFILE" 2>/dev/null || true)"
  if [[ -n "${old:-}" && "$old" != "$$" ]] && kill -0 "$old" 2>/dev/null; then
    exit 0
  fi
fi
echo $$ >"$PIDFILE"
trap 'rm -f "$PIDFILE"' EXIT

show() { "$OSK" show >/dev/null 2>&1 || true; }
hide() { "$OSK" hide >/dev/null 2>&1 || true; }

was=0
while true; do
  # exit 0 = locked, 1 = unlocked, 2 = undetermined (treat as unlocked)
  if [[ -x "$LOCKCHECK" ]] && "$LOCKCHECK"; then
    if [[ $was -eq 0 ]]; then show; was=1; fi
  else
    if [[ $was -eq 1 ]]; then hide; was=0; fi
  fi
  sleep 1
done
