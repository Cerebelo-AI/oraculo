#!/usr/bin/env python3
"""Steam Deck physical controls -> desktop actions (Omarchy / Hyprland).

Reads the controller HID reports directly (same path Steam uses), so it sees
every button, both sticks, the triggers and the IMU even while the firmware is
in mouse+keyboard ("lizard") mode. Lizard mode keeps working underneath:
A = Enter, B = Esc, D-pad = arrows, R2/L2 = left/right click, right trackpad =
mouse, left trackpad = scroll.

Mapping v7 (Fable, 2026-09-22) — edit MAP / CHORD below.
  The firmware keyboard device (lizard: D-pad = arrows, A = Enter, B = Esc) is
  GRABBED by this daemon so the buttons below can be remapped; if the daemon
  dies the grab is released and the firmware keys come back on their own.
  D-pad    down = copy   up = paste   (Ctrl+Shift+C/V in terminals, Ctrl+C/V elsewhere)
           left = "@"    right = "/"
  A        tap -> Enter                         hold -> Shift+Enter (newline, no send)
  B        tap -> Backspace                     hold -> Backspace repeat
  Steam    tap -> on-screen keyboard             hold -> dictation (Wispr Flow PTT =
                                                          Ctrl+Super; Voxtype if Wispr
                                                          is not running)
  "..."    tap -> Omarchy menu                   held + button -> CHORD layer (below)
  X        tap -> screenshot (region)            hold -> screenshot (whole screen)
  Y        tap -> Super+F (fullscreen)           hold -> Super+Alt+F (maximized, keeps bar/OSK room)
  L1 / R1  tap -> focus window to the left / right (Super+Left/Right)
           L1 held + right stick -> move window inside the workspace (swap by direction)
           R1 held + right stick -> carry window to workspace 1/2/3/4 (up/right/down/left); R1 held + R3 click -> 5
  L4 / R4  tap -> previous / next workspace
  L5       tap -> Ctrl+F (find)                 hold -> SUPER held (touch a key)
  R5       tap -> Space                          hold -> CTRL held (touch a key)
  Select   tap -> Mosaico (toggle: closes if open) hold -> Voxtype dictation (offline)
  Start    tap -> tarefas (Super+R)              hold -> close window (Super+W)
  L3       tap -> drag lock (left button held until the next tap; drag with the right trackpad)
           Left trackpad click -> right click
  R3       tap -> Enter
  Left stick flick  -> Super+arrow (Omarchy: focus window in that direction); hold = repeat
  Right stick       -> arrow keys (text cursor / lists), typematic repeat while held
  Left trackpad     -> scroll (firmware)
  Gyro              -> mouse while the right stick is touched (capacitive)

  CHORD ("..." held + ...):
    X = screen recording start/stop     Y = toggle floating   A = OCR (text from screen)
    B = Esc                             Steam = keybindings cheat sheet
    L1 / R1 = swap window left/right    L4 / R4 = move window to prev/next workspace
    L5 = Downloads folder               R5 = close window
    Start = clipboard manager           Select = iniciar
    D-pad up/down = Ctrl+= / Ctrl+- (zoom in/out), left/right = Ctrl+0 (reset)
    R3 = screen zoom 2x on/off (magnifier follows the cursor)
    (lock screen / top bar / screensaver / touchscreen toggle: via the Omarchy menu)

Virtual devices via uinput (needs rw on /dev/uinput: 70-wispr-flow-uinput.rules,
module uinput, group input): "steamdeck-buttons-kbd" (keys) and
"steamdeck-buttons-mouse" (scroll, gyro mouse, middle click).

Deck state report (drivers/hid/hid-steam.c): report[0]==1, report[2]==9;
buttons bytes 8..14; int16 LE fields: lpad 16/18, rpad 20/22, accel 24/26/28,
gyro 30/32/34, quaternion 36..42, triggers 44/46, lstick 48/50, rstick 52/54.
Debug: STEAMDECK_BUTTONS_DEBUG=1 logs every button-byte transition.
"""
# v7.8 stick modifiers; v7.9 L1/R1 tap = focus left/right; v7.10 absolute workspaces; v7.11 mic never re-muted; v7.12 drag lock + zoom keys
import glob
import json
import os
import re
import select
import shutil
import struct
import subprocess
import sys
import threading
import time

OSK = os.path.expanduser("~/.local/bin/steamdeck-osk")
HOME = os.path.expanduser("~")
STATE_DIR = os.path.join(HOME, ".local/state/steamdeck-buttons")
STATE = os.path.join(STATE_DIR, "audio.json")
DEBUG = os.environ.get("STEAMDECK_BUTTONS_DEBUG") == "1"

HOLD_S = 0.30          # default hold threshold
HOLD_CLOSE_S = 0.60    # closing a window needs a deliberate hold
CHORD_MAX_S = 0.60     # "..." released within this and without a chord = menu
DEBOUNCE_S = 0.20

# analog tuning
STICK_MAX = 32767
SCROLL_DEADZONE = 5000
SCROLL_NOTCHES_PER_S = 22.0      # at full deflection
FLICK_ON = 20000                 # left stick: fire when crossing this ...
FLICK_REPEAT_S = 0.30            # ... and again every N s while held past it
ARROW_ON = 11000                 # right stick arrows: fire past this (~1/3 travel) ...
ARROW_OFF = 6000                 # ... re-arm below this
ARROW_FIRST_S = 0.35             # right stick arrows: typematic delay ...
ARROW_REPEAT_S = 0.085           # ... and rate while held
FLICK_OFF = 8000                 # ... re-arm when back below this
GYRO_GAIN = 0.0028               # px per raw gyro unit per report (~250 Hz)
GYRO_DEADZONE = 40
STICK_WORKSPACES = {"u": "1", "r": "2", "d": "3", "l": "4"}   # R1 held + right stick (clockwise from top); R1 + R3 = 5
DRAG = {"on": False}   # v7.12 drag lock state (L3)
ZOOM_FACTOR = 2.0
BURST_RESIDUE_MAX = 0.05             # sink at/below this = leftover of the volume-down burst

# (byte, bit) per hid-steam.c
BUTTONS = {
    "r2": (8, 0), "l2": (8, 1), "r1": (8, 2), "l1": (8, 3),
    "y": (8, 4), "b": (8, 5), "x": (8, 6), "a": (8, 7),
    "up": (9, 0), "right": (9, 1), "left": (9, 2), "down": (9, 3),
    "select": (9, 4), "steam": (9, 5), "start": (9, 6), "l5": (9, 7),
    "r5": (10, 0), "lpad_click": (10, 1), "rpad_click": (10, 2),
    "lpad_touch": (10, 3), "rpad_touch": (10, 4), "l3": (10, 6),
    "r3": (11, 2),
    "l4": (13, 1), "r4": (13, 2), "lstick_touch": (13, 6), "rstick_touch": (13, 7),
    "qam": (14, 2),
}


def run(cmd):
    return ("run", cmd)


def sh(cmdline):
    return ("run", ["bash", "-lc", cmdline])


def dsp(lua):
    return ("run", ["hyprctl", "dispatch", lua])


def seq(*actions):
    return ("seq", actions)


# Actions: "tap" fires on release if held < hold_s (or on the press edge when
# the button has no hold action); "hold" fires once at the threshold;
# "release" fires when a held button is let go.
MAP = {
    "steam":  {"tap": run([OSK, "toggle"]), "hold": ("dictation", "start"), "release": ("dictation", "stop")},
    "x":      {"tap": run(["omarchy-capture-screenshot", "region"]),
               "hold": run(["omarchy-capture-screenshot", "fullscreen"])},
    "y":      {"tap": ("key", ["super", "f"]),   # Super+F (Omarchy: tela cheia)
               "hold": ("key", ["super", "alt", "f"])},   # Super+Alt+F (Omarchy: tela cheia com borda)
    "l1":     {"tap": dsp('hl.dsp.focus({ direction = "l" })'),   # foco na janela da esquerda (nunca vai e volta)
               "stick": "swap"},        # L1 segurado + analogico direito = mover janela dentro da mesa
    "r1":     {"tap": dsp('hl.dsp.focus({ direction = "r" })'),   # foco na janela da direita
               "stick": "workspace"},   # R1 segurado + analogico direito = levar janela para a mesa 1/2/3/4 (cima/dir/baixo/esq)
    "l4":     {"tap": dsp('hl.dsp.focus({ workspace = "e-1" })')},
    "r4":     {"tap": dsp('hl.dsp.focus({ workspace = "e+1" })')},
    "l5":     {"tap": ("key", ["ctrl", "f"]),    # localizar na pagina
               "hold": ("modkey", "super"), "release": ("modkey_up", "super")},
    "r5":     {"tap": ("key", ["space"]),        # Espaco (ditado + @ sem abrir o teclado)
               "hold": ("modkey", "ctrl"), "release": ("modkey_up", "ctrl")},
    "select": {"tap": sh("command -v mosaico >/dev/null && setsid mosaico || omarchy-menu toggle apps"),  # mosaico e single-instance: 2a chamada fecha (toggle)
               "hold": ("voxtype", "start"), "release": ("voxtype", "stop")},
    "start":  {"tap": run(["omarchy-launch-or-focus", "org.omarchy.tarefas", "xdg-terminal-exec --app-id=org.omarchy.tarefas -e tarefas --janela"]),
               "hold": dsp("hl.dsp.window.close()")},   # Super+W (fechar janela)
    "l3":     {"tap": ("drag_lock", None)},   # segura o clique esquerdo para arrastar com o trackpad; toca de novo para soltar
    "lpad_click": {"tap": ("click", "right")},   # trackpad esquerdo clicado = botao direito
    "r3":     {"tap": ("key", ["enter"]),
               "with_r1": dsp('hl.dsp.window.move({ workspace = "5" })')},   # R1 segurado + clique do stick = mesa 5
    # v7: D-pad / A / B (the firmware's own arrows/Enter/Esc are grabbed, see grab_lizard_keyboard)
    "down":   {"tap": ("copy", None)},
    "up":     {"tap": ("paste", None)},
    "left":   {"tap": ("key", ["shift", "2"])},        # "@" (us-intl)
    "right":  {"tap": ("key", ["slash"])},             # "/"
    "a":      {"tap": ("key", ["enter"]), "hold": ("key", ["shift", "enter"])},
    "b":      {"tap": ("key", ["backspace"]), "hold": ("repeat", "backspace"), "release": ("repeat_stop", None)},
}

# "..." held + button (fires on the press edge of the second button)
CHORD = {
    "x":      sh("omarchy-capture-screenrecording --stop-recording || omarchy-menu toggle trigger.capture.screenrecord"),
    "y":      dsp('hl.dsp.window.float({ action = "toggle" })'),
    "a":      run(["omarchy-capture-text"]),
    "b":      ("key", ["esc"]),
    "steam":  run(["omarchy-menu-keybindings"]),
    "l1":     dsp('hl.dsp.window.swap({ direction = "l" })'),
    "r1":     dsp('hl.dsp.window.swap({ direction = "r" })'),
    "l4":     dsp('hl.dsp.window.move({ workspace = "e-1" })'),
    "r4":     dsp('hl.dsp.window.move({ workspace = "e+1" })'),
    "l5":     run(["xdg-open", f"{HOME}/Downloads"]),
    "r5":     dsp("hl.dsp.window.close()"),
    "start":  run(["omarchy-menu-clipboard"]),
    "select": run(["omarchy-launch-or-focus", "org.omarchy.iniciar", "xdg-terminal-exec --app-id=org.omarchy.iniciar -e iniciar"]),
    "left":   ("key", ["ctrl", "0"]),      # zoom 100%
    "right":  ("key", ["ctrl", "0"]),
    "up":     ("key", ["ctrl", "equal"]),  # zoom in (browser, editores)
    "down":   ("key", ["ctrl", "minus"]),  # zoom out
    "r3":     ("zoom", ZOOM_FACTOR),
}

# ---------------------------------------------------------------- uinput ---
KBD = None
MOUSE = None
KEYS = {}
try:
    import evdev
    from evdev import ecodes as e

    KEYS = {"ctrl": e.KEY_LEFTCTRL, "super": e.KEY_LEFTMETA, "shift": e.KEY_LEFTSHIFT,
            "alt": e.KEY_LEFTALT, "v": e.KEY_V, "c": e.KEY_C, "tab": e.KEY_TAB,
            "enter": e.KEY_ENTER, "backspace": e.KEY_BACKSPACE, "esc": e.KEY_ESC,
            "up": e.KEY_UP, "down": e.KEY_DOWN, "left": e.KEY_LEFT, "right": e.KEY_RIGHT,
            "2": e.KEY_2, "slash": e.KEY_SLASH, "f": e.KEY_F, "space": e.KEY_SPACE,
            "equal": e.KEY_EQUAL, "minus": e.KEY_MINUS, "0": e.KEY_0}
    # Registra o teclado inteiro (KEY_ESC..KEY_MICMUTE), nao so as teclas usadas: o udev so marca
    # ID_INPUT_KEYBOARD com o bloco ESC/1-0/Q-D completo, e o helper do Wispr Flow so escuta
    # dispositivos assim (evdev capture). Sem isto, segurar Steam (Ctrl+Super) nunca chegava ao Wispr.
    KBD = evdev.UInput({e.EV_KEY: list(range(1, 249))}, name="steamdeck-buttons-kbd", vendor=0x28de, product=0x1205)
    MOUSE = evdev.UInput({e.EV_KEY: [e.BTN_LEFT, e.BTN_RIGHT, e.BTN_MIDDLE],
                          e.EV_REL: [e.REL_X, e.REL_Y, e.REL_WHEEL, e.REL_HWHEEL]},
                         name="steamdeck-buttons-mouse", vendor=0x28de, product=0x1206)
    print("steamdeck-buttons: uinput keyboard + mouse ready", flush=True)
except Exception as exc:  # noqa: BLE001
    print(f"steamdeck-buttons: uinput unavailable ({exc}); keys/scroll/gyro disabled", file=sys.stderr, flush=True)


def keys_state(names, value):
    if KBD is None:
        return False
    for n in names:
        KBD.write(e.EV_KEY, KEYS[n], value)
    KBD.syn()
    return True


def key_combo(names):
    """Press names in order, release in reverse (e.g. ["ctrl", "shift", "c"])."""
    if not keys_state(names, 1):
        return
    time.sleep(0.01)
    keys_state(list(reversed(names)), 0)


# Terminal-like windows want Ctrl+Shift+C/V (Ctrl+C would interrupt the program).
TERMINAL_CLASS = re.compile(r"^(com\.mitchellh\.ghostty|org\.omarchy\.(?!mosaico$)|Alacritty|kitty|foot|org\.wezfurlong\.wezterm)")


def active_window_class():
    try:
        out = subprocess.run(["hyprctl", "activewindow", "-j"], capture_output=True, text=True, timeout=2).stdout
        return json.loads(out).get("class", "") or ""
    except Exception:  # noqa: BLE001
        return ""


def clipboard_combo(letter):
    cls = active_window_class()
    return ["ctrl", "shift", letter] if TERMINAL_CLASS.match(cls) else ["ctrl", letter]


REPEAT = {"stop": None}


def repeat_key(name, first_delay=0.0, interval=0.045):
    stop = threading.Event()
    REPEAT["stop"] = stop

    def loop():
        time.sleep(first_delay)
        while not stop.is_set():
            key_combo([name])
            time.sleep(interval)
    threading.Thread(target=loop, daemon=True).start()


def repeat_stop():
    if REPEAT["stop"] is not None:
        REPEAT["stop"].set()
        REPEAT["stop"] = None


def mouse_button(code, value):
    if MOUSE is None:
        return
    MOUSE.write(e.EV_KEY, code, value)
    MOUSE.syn()


def mouse_rel(dx=0, dy=0, wheel=0, hwheel=0):
    if MOUSE is None:
        return
    if dx:
        MOUSE.write(e.EV_REL, e.REL_X, int(dx))
    if dy:
        MOUSE.write(e.EV_REL, e.REL_Y, int(dy))
    if wheel:
        MOUSE.write(e.EV_REL, e.REL_WHEEL, int(wheel))
    if hwheel:
        MOUSE.write(e.EV_REL, e.REL_HWHEEL, int(hwheel))
    MOUSE.syn()


# -------------------------------------------------------------- actions ---
def spawn(cmd):
    try:
        subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except Exception as exc:  # noqa: BLE001
        print(f"steamdeck-buttons: failed to run {cmd}: {exc}", file=sys.stderr, flush=True)


def wispr_running():
    return subprocess.run(["pgrep", "-x", "wispr-flow"], capture_output=True).returncode == 0


ZOOM = {"on": False}
DICT_MODE = {"steam": None}


def zoom_toggle(factor):
    ZOOM["on"] = not ZOOM["on"]
    f = factor if ZOOM["on"] else 1.0
    spawn(["hyprctl", "eval", f"hl.config({{ cursor = {{ zoom_factor = {f} }} }})"])


def do(action):
    kind, arg = action
    if kind == "run":
        spawn(arg)
    elif kind == "seq":
        for a in arg:
            do(a)
            time.sleep(0.05)
    elif kind == "voxtype":
        spawn(["voxtype", "record", arg])
    elif kind == "click":
        code = {"middle": e.BTN_MIDDLE, "left": e.BTN_LEFT, "right": e.BTN_RIGHT}[arg]
        mouse_button(code, 1)
        mouse_button(code, 0)
    elif kind == "drag_lock":
        # tap = hold the left button down (drag with the right trackpad); tap again = release
        DRAG["on"] = not DRAG["on"]
        mouse_button(e.BTN_LEFT, 1 if DRAG["on"] else 0)
        print(f"steamdeck-buttons: drag lock {'ON' if DRAG['on'] else 'off'}", flush=True)
    elif kind == "zoom":
        zoom_toggle(arg)
    elif kind == "key":
        key_combo(arg)
    elif kind == "copy":
        key_combo(clipboard_combo("c"))
    elif kind == "paste":
        key_combo(clipboard_combo("v"))
    elif kind == "repeat":
        repeat_key(arg)
    elif kind == "repeat_stop":
        repeat_stop()
    elif kind == "modkey":
        # grip held = modifier held; touch/type the other key meanwhile
        keys_state([arg], 1)
    elif kind == "modkey_up":
        keys_state([arg], 0)
    elif kind == "dictation":
        # Wispr Flow push-to-talk = Ctrl+Super held (same shortcut as the ThinkPad).
        if arg == "start":
            if wispr_running() and keys_state(["ctrl", "super"], 1):
                DICT_MODE["steam"] = "wispr"
            else:
                DICT_MODE["steam"] = "voxtype"
                spawn(["voxtype", "record", "start"])
        else:
            if DICT_MODE["steam"] == "wispr":
                keys_state(["ctrl", "super"], 0)
                threading.Thread(target=unstick_wispr_mods, daemon=True).start()
            elif DICT_MODE["steam"] == "voxtype":
                spawn(["voxtype", "record", "stop"])
            DICT_MODE["steam"] = None


# ---------------------------------------------------------------- audio ---
def _wpctl(*args):
    try:
        return subprocess.run(["wpctl", *args], capture_output=True, text=True, timeout=5).stdout.strip()
    except Exception:  # noqa: BLE001
        return ""


def snapshot_audio():
    """Current sink/source volume; a 0.00 sink is treated as a leftover of a
    previous volume-down burst and replaced by the last good value on disk."""
    snap = {}
    for target in ("@DEFAULT_AUDIO_SINK@", "@DEFAULT_AUDIO_SOURCE@"):
        out = _wpctl("get-volume", target)  # "Volume: 0.60 [MUTED]"
        parts = out.split()
        if len(parts) >= 2:
            try:
                snap[target] = (float(parts[1]), "MUTED" in out)
            except ValueError:
                pass
    try:
        saved = json.load(open(STATE))
    except Exception:  # noqa: BLE001
        saved = {}
    sink = "@DEFAULT_AUDIO_SINK@"
    src = "@DEFAULT_AUDIO_SOURCE@"
    if src in snap:
        # the mic is never left muted by us: a muted/zeroed source is burst residue
        vol = snap[src][0] if snap[src][0] > BURST_RESIDUE_MAX else saved.get(src, [0.8])[0]
        snap[src] = (vol if vol > BURST_RESIDUE_MAX else 0.8, False)
    residue = snap.get(sink, (0.0, False))[0] <= BURST_RESIDUE_MAX
    if residue and saved.get(sink, [0.0])[0] > BURST_RESIDUE_MAX:
        snap[sink] = tuple(saved[sink])
    if not residue or sink not in saved:
        try:
            os.makedirs(STATE_DIR, exist_ok=True)
            json.dump(snap, open(STATE, "w"))
        except Exception:  # noqa: BLE001
            pass
    return snap


def restore_audio(snap, delays=(6.0, 12.0)):
    for delay in delays:
        time.sleep(delay)
        for target, (vol, muted) in snap.items():
            _wpctl("set-volume", target, f"{vol:.2f}")
            _wpctl("set-mute", target, "1" if muted else "0")
        print(f"steamdeck-buttons: audio state restored {snap}", flush=True)


# --------------------------------------------------------------- buttons ---
class Button:
    def __init__(self, name, spec):
        self.name = name
        self.spec = spec
        self.hold_s = spec.get("hold_s", HOLD_S)
        self.pressed = False
        self.down_at = None
        self.held = False
        self.last_fire = 0.0
        self.stick_used = False   # v7.8 stick modifiers

    def update(self, pressed, now, chord, stickmod=None):
        if pressed and not self.pressed:
            if stickmod is not None and stickmod is not self and f"with_{stickmod.name}" in self.spec:
                stickmod.stick_used = True
                print(f"steamdeck-buttons: {stickmod.name}+{self.name}", flush=True)
                do(self.spec[f"with_{stickmod.name}"])
                self.pressed = True
                self.down_at = None
                return
            if chord.active:
                chord.used = True
                if self.name in CHORD:
                    do(CHORD[self.name])
                self.pressed = True
                self.down_at = None
                return
            self.down_at = now
            self.held = False
            self.stick_used = False
            if "stick" in self.spec:
                self.pressed = True
                return
            if "hold" not in self.spec and "tap" in self.spec and now - self.last_fire > DEBOUNCE_S:
                self.last_fire = now
                do(self.spec["tap"])
        elif pressed and self.pressed:
            self.tick(now)
        elif not pressed and self.pressed:
            if self.held:
                if "release" in self.spec:
                    do(self.spec["release"])
            elif self.down_at is not None and "stick" in self.spec and "tap" in self.spec and not self.stick_used and now - self.last_fire > DEBOUNCE_S:
                self.last_fire = now
                do(self.spec["tap"])
            elif self.down_at is not None and "hold" in self.spec and "tap" in self.spec and now - self.last_fire > DEBOUNCE_S:
                self.last_fire = now
                do(self.spec["tap"])
            self.down_at = None
            self.held = False
        self.pressed = pressed

    def tick(self, now):
        if self.pressed and not self.held and "hold" in self.spec and self.down_at is not None and now - self.down_at >= self.hold_s:
            self.held = True
            self.last_fire = now
            do(self.spec["hold"])


class Chord:
    """The '...' button: tap = menu, held + other button = CHORD layer."""

    def __init__(self):
        self.active = False
        self.used = False
        self.down_at = None

    def update(self, pressed, now):
        if pressed and not self.active:
            self.active = True
            self.used = False
            self.down_at = now
        elif not pressed and self.active:
            if not self.used and self.down_at is not None and now - self.down_at < CHORD_MAX_S:
                spawn(["omarchy-menu", "toggle", "root"])
            self.active = False
            self.used = False
            self.down_at = None


class Analog:
    def __init__(self):
        self.scroll_acc = [0.0, 0.0]
        self.flick_armed = True
        self.flick_next = 0.0
        self.arrow_dir = None
        self.arrow_next = 0.0
        self.rflick_armed = True
        self.rflick_next = 0.0
        self.gyro_acc = [0.0, 0.0]
        self.last = 0.0

    def update(self, d, now, chord, rstick_touch, stickmod=None):
        dt = min(now - self.last, 0.05) if self.last else 0.004
        self.last = now
        lx, ly = struct.unpack_from("<hh", d, 48)
        rx, ry = struct.unpack_from("<hh", d, 52)
        # right stick -> arrow keys with typematic repeat (text cursor, lists, menus)
        rmag = max(abs(rx), abs(ry))
        if stickmod is not None:
            # L1/R1 held: right stick flicks move the window instead of typing arrows
            self.arrow_dir = None
            if rmag > ARROW_ON and (self.rflick_armed or now >= self.rflick_next):
                self.rflick_armed = False
                self.rflick_next = now + FLICK_REPEAT_S
                stickmod.stick_used = True
                mode = stickmod.spec["stick"]
                if abs(rx) >= abs(ry):
                    direction = "r" if rx > 0 else "l"
                else:
                    direction = "u" if ry > 0 else "d"
                if mode == "swap":
                    print(f"steamdeck-buttons: {stickmod.name}+stick swap {direction}", flush=True)
                    do(dsp(f'hl.dsp.window.swap({{ direction = "{direction}" }})'))
                elif mode == "workspace":
                    ws = STICK_WORKSPACES[direction]
                    print(f"steamdeck-buttons: {stickmod.name}+stick move window to workspace {ws}", flush=True)
                    do(dsp(f'hl.dsp.window.move({{ workspace = "{ws}" }})'))
            elif rmag < ARROW_OFF:
                self.rflick_armed = True
        elif rmag > ARROW_ON:
            if abs(rx) >= abs(ry):
                adir = "right" if rx > 0 else "left"
            else:
                adir = "up" if ry > 0 else "down"
            if adir != self.arrow_dir:
                self.arrow_dir = adir
                self.arrow_next = now + ARROW_FIRST_S
                do(("key", [adir]))
            elif now >= self.arrow_next:
                self.arrow_next = now + ARROW_REPEAT_S
                do(("key", [adir]))
        elif rmag < ARROW_OFF:
            self.arrow_dir = None
        # left stick flick -> Super+arrow = focus direction (chord: move window); repeats while held
        mag = max(abs(lx), abs(ly))
        if mag > FLICK_ON and (self.flick_armed or now >= self.flick_next):
            self.flick_armed = False
            self.flick_next = now + FLICK_REPEAT_S
            if abs(lx) >= abs(ly):
                direction = "r" if lx > 0 else "l"
            else:
                direction = "u" if ly > 0 else "d"
            if chord.active:
                chord.used = True
                do(dsp(f'hl.dsp.window.swap({{ direction = "{direction}" }})'))
            else:
                do(("key", ["super", {"r": "right", "l": "left", "u": "up", "d": "down"}[direction]]))
        elif mag < FLICK_OFF:
            self.flick_armed = True
        # gyro -> mouse while the right stick is touched and at rest (not while scrolling)
        if rstick_touch and max(abs(rx), abs(ry)) < SCROLL_DEADZONE:
            gp, gr, gy = struct.unpack_from("<hhh", d, 30)
            if abs(gy) > GYRO_DEADZONE:
                self.gyro_acc[0] += -gy * GYRO_GAIN
            if abs(gp) > GYRO_DEADZONE:
                self.gyro_acc[1] += -gp * GYRO_GAIN
            dx, dy = int(self.gyro_acc[0]), int(self.gyro_acc[1])
            if dx or dy:
                self.gyro_acc[0] -= dx
                self.gyro_acc[1] -= dy
                mouse_rel(dx=dx, dy=dy)
        else:
            self.gyro_acc = [0.0, 0.0]


def kick_wispr_helper():
    """The Wispr helper enumerates evdev keyboards only at start; our uinput keyboard is new
    on every daemon start, so the helper would never see Ctrl+Super again. SIGTERM makes the
    main app respawn the helper (~1 s), which then picks up the new device. No coredump."""
    time.sleep(2.0)
    try:
        out = subprocess.run(["pgrep", "-f", "wispr-flow-linux-helper$"], capture_output=True, text=True).stdout.split()
        for pid in out:
            fds = " ".join(os.readlink(f"/proc/{pid}/fd/{f}") for f in os.listdir(f"/proc/{pid}/fd") if True)
            if KBD is not None and KBD.device.path in fds:
                continue
            os.kill(int(pid), 15)
            print(f"steamdeck-buttons: restarted wispr helper {pid} so it sees {KBD.device.path if KBD else '?'}", flush=True)
    except Exception as exc:  # noqa: BLE001
        print(f"steamdeck-buttons: wispr helper check failed: {exc}", file=sys.stderr, flush=True)


def unstick_wispr_mods(delay=1.0):
    """After push-to-talk, the Wispr helper's own uinput keyboard sometimes keeps Super/Ctrl
    down (every click then drags the window). Restarting the helper destroys that device and
    the kernel releases the keys; the main app respawns it in ~1 s."""
    time.sleep(delay)
    try:
        for path in evdev.list_devices():
            dev = evdev.InputDevice(path)
            if "Wispr" not in dev.name:
                continue
            stuck = [k for k in dev.active_keys() if k in (e.KEY_LEFTMETA, e.KEY_LEFTCTRL, e.KEY_RIGHTMETA, e.KEY_RIGHTCTRL)]
            if stuck:
                for pid in subprocess.run(["pgrep", "-f", "wispr-flow-linux-helper$"], capture_output=True, text=True).stdout.split():
                    os.kill(int(pid), 15)
                print(f"steamdeck-buttons: wispr helper had stuck modifiers {stuck}; restarted it", flush=True)
    except Exception as exc:  # noqa: BLE001
        print(f"steamdeck-buttons: unstick check failed: {exc}", file=sys.stderr, flush=True)


LIZARD = {"dev": None}


def grab_lizard_keyboard():
    """Grab the controller's firmware keyboard (D-pad=arrows, A=Enter, B=Esc) so only the
    remapped keys above reach the compositor. Released automatically if the daemon exits."""
    if KBD is None:
        return
    for path in sorted(glob.glob("/dev/input/by-id/usb-Valve_Software_Steam_Deck_Controller_*-event-kbd")):
        try:
            if LIZARD["dev"] is not None:
                try:
                    LIZARD["dev"].ungrab()
                    LIZARD["dev"].close()
                except Exception:  # noqa: BLE001
                    pass
            dev = evdev.InputDevice(path)
            dev.grab()
            LIZARD["dev"] = dev

            def drain():
                try:
                    for _ in dev.read_loop():
                        pass
                except Exception:  # noqa: BLE001
                    pass
            threading.Thread(target=drain, daemon=True).start()
            print(f"steamdeck-buttons: grabbed firmware keyboard {path} (arrows/Enter/Esc remapped)", flush=True)
            return
        except Exception as exc:  # noqa: BLE001
            print(f"steamdeck-buttons: cannot grab {path}: {exc}", file=sys.stderr, flush=True)


def find_device():
    for path in sorted(glob.glob("/dev/input/by-id/usb-Valve_Software_Steam_Deck_Controller_*-if02-hidraw")):
        return os.path.realpath(path)
    return None


def main():
    # single instance (autostart.lua + manual restarts must not double-fire)
    import fcntl
    os.makedirs(STATE_DIR, exist_ok=True)
    lock = open(os.path.join(STATE_DIR, "daemon.lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print("steamdeck-buttons: another instance is running; exiting", file=sys.stderr, flush=True)
        return
    if shutil.which("hyprctl") is None:
        print("steamdeck-buttons: hyprctl not in PATH", file=sys.stderr, flush=True)
    buttons = {n: Button(n, MAP.get(n, {})) for n in BUTTONS if n != "qam"}
    chord = Chord()
    analog = Analog()
    prev_bytes = None
    while True:
        dev = find_device()
        if not dev:
            time.sleep(3)
            continue
        audio_snapshot = snapshot_audio()
        try:
            fd = os.open(dev, os.O_RDONLY)
        except OSError as exc:
            print(f"steamdeck-buttons: cannot open {dev}: {exc}", file=sys.stderr, flush=True)
            time.sleep(5)
            continue
        print(f"steamdeck-buttons: listening on {dev}", flush=True)
        grab_lizard_keyboard()
        threading.Thread(target=kick_wispr_helper, daemon=True).start()
        # Opening the hidraw client makes the controller emit a burst of
        # "volume down" (sink 0.60 -> 0.00 muted in ~4 s): restore afterwards.
        threading.Thread(target=restore_audio, args=(audio_snapshot,), daemon=True).start()
        try:
            while True:
                r, _, _ = select.select([fd], [], [], 0.05)
                now = time.monotonic()
                if not r:
                    for b in buttons.values():
                        b.tick(now)
                    continue
                d = os.read(fd, 64)
                if len(d) < 60 or d[0] != 1 or d[2] != 9:
                    continue
                if DEBUG:
                    cur = bytes(d[8:16])
                    if cur != prev_bytes:
                        print("steamdeck-buttons: bytes8-15 " + " ".join(f"{b:08b}" for b in cur), flush=True)
                        prev_bytes = cur
                byte, bit = BUTTONS["qam"]
                chord.update(bool(d[byte] & (1 << bit)), now)
                stickmod = next((b for b in buttons.values() if b.pressed and "stick" in b.spec), None)
                for name, b in buttons.items():
                    byte, bit = BUTTONS[name]
                    b.update(bool(d[byte] & (1 << bit)), now, chord, stickmod)
                byte, bit = BUTTONS["rstick_touch"]
                stickmod = next((b for b in buttons.values() if b.pressed and "stick" in b.spec), None)
                analog.update(d, now, chord, bool(d[byte] & (1 << bit)), stickmod)
        except OSError as exc:
            print(f"steamdeck-buttons: read error on {dev}: {exc}; reopening", file=sys.stderr, flush=True)
            try:
                os.close(fd)
            except OSError:
                pass
            time.sleep(2)


if __name__ == "__main__":
    main()
